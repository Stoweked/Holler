# Copy to .env.local and fill in. Required for `next build` and `next dev`.

# maple API base URL. The client appends /api/v1 (src/lib/maple/client.ts).
NEXT_PUBLIC_MAPLE_API_URL=http://localhost:8080

# Cognito OAuth callback. Must match an allowed callback URL registered on the
# Cognito app client, and the port `next dev` serves on.
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# Supabase — still backing contacts, projects, business, waivers, account and
# feedback. Being retired; see hollermeta SPEC 13.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
